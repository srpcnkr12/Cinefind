# Ortak
NODE_ENV=
APP_ENV=local|staging|production

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # yalnızca sunucu / edge functions
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Film verisi
TMDB_API_READ_ACCESS_TOKEN=
FILM_DATA_PROVIDER=tmdb|fixture

# AI
ANTHROPIC_API_KEY=                     # yalnızca edge function

# Ödeme
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Yalnızca yerel geliştirme/mock satın alma akışı (bkz. ADR-0014) — gerçek
# `REVENUECAT_WEBHOOK_AUTH` ile ASLA aynı değer olmamalı; gerçek SDK
# eklendiğinde bu değişken ve mock sağlayıcı tamamen kaldırılır.
EXPO_PUBLIC_MOCK_PURCHASES_WEBHOOK_AUTH=

# Moderasyon
MODERATION_PROVIDER=mock|<sağlayıcı>
MODERATION_API_KEY=

# Gözlemleme
# NOT (Faz 10): Sentry DSN'i gizli değildir (yalnızca olay GÖNDERMeye izin verir,
# okumaya değil) — istemci koduna gömülmesi gerektiği için EXPO_PUBLIC_/NEXT_PUBLIC_
# önekiyle taşınıyor (aksi halde Metro/Next.js build-time'da istemciye hiç ulaşmaz).
EXPO_PUBLIC_SENTRY_DSN_MOBILE=
NEXT_PUBLIC_SENTRY_DSN_WEB=
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# Web
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_ATTRIBUTION_LINK_BASE=
REVALIDATE_SECRET=

# E-posta
RESEND_API_KEY=
